# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://marketplace.theathletemarket.com
NEXT_PUBLIC_MAIN_SITE_URL=https://theathletemarket.com
# 32+ random chars. Signs every magic link and the admin session. Rotating it invalidates all links.
# Generate: openssl rand -base64 48
APP_SECRET=
# Internal admin dashboard password (use a long random passphrase).
ADMIN_PASSWORD=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically when this is set.
CRON_SECRET=
# Ops alerts (failed refunds/payouts, disputes, new applications)
ADMIN_ALERT_EMAIL=
# Physical mailing address required in emails (CAN-SPAM)
COMPANY_POSTAL_ADDRESS="The Athlete Market, 123 Example St, City, ST 00000"

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
# Server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_SCHEMA=marketplace
SUPABASE_VIDEO_BUCKET=marketplace-videos

# ─── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the "Your account" webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_...
# Signing secret of the "Connected accounts" webhook endpoint (same URL)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# ─── Resend ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
# Resend → Webhooks → add https://marketplace.theathletemarket.com/api/resend/webhook
# (events: email.bounced, email.complained) → copy its signing secret here
RESEND_WEBHOOK_SECRET=whsec_...
EMAIL_FROM="The Athlete Market <evaluations@mail.theathletemarket.com>"
EMAIL_REPLY_TO=support@theathletemarket.com

# ─── Twilio (coach text alerts + founder order alerts) ──────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
# Use your A2P 10DLC-registered Messaging Service (preferred) — or a TWILIO_FROM_NUMBER (+1...)
TWILIO_MESSAGING_SERVICE_SID=MG...
# Your own mobile: get a text for every new order, low rating, and video awaiting review
ADMIN_ALERT_PHONE=+1...

# ─── Local demo (no credentials needed) ─────────────────────────────────────
# DEMO_MODE=1   → in-memory DB + simulated Stripe/Resend/storage. Refuses to run on Vercel production.
